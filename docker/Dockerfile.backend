# 后端 Dockerfile：Python 3.13 + uv + gunicorn
FROM python:3.13-slim AS builder

# 安装系统依赖（编译 mysqlclient/psycopg 需要）
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    default-libmysqlclient-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# 安装 uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# 先复制依赖文件以利用 Docker 缓存
COPY pyproject.toml uv.lock* ./

# 安装依赖到虚拟环境
RUN uv sync --frozen --no-dev --no-install-project

# ---- 运行阶段 ----
FROM python:3.13-slim

# 安装运行时系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    libmariadb3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 从 builder 复制虚拟环境
COPY --from=builder /app/.venv /app/.venv

# 复制项目代码
COPY backend/ ./backend/

# 环境变量
ENV PATH="/app/.venv/bin:$PATH" \
    DJANGO_SETTINGS_MODULE=rdbase.settings.prod \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app/backend

# 收集静态文件
RUN python manage.py collectstatic --noinput

# 暴露端口
EXPOSE 8000

# 启动命令：gunicorn + uvicorn worker（worker 数量由环境变量控制）
CMD ["gunicorn", \
     "--bind", "0.0.0.0:8000", \
     "--workers", "4", \
     "--worker-class", "uvicorn.workers.UvicornWorker", \
     "--timeout", "120", \
     "--graceful-timeout", "30", \
     "--preload", \
     "--access-logfile", "-", \
     "--error-logfile", "-", \
     "rdbase.asgi:application"]

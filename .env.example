# rdbase Docker 部署环境变量
# 复制此文件为 .env 并修改对应值

# Django 密钥（生产环境必须修改）
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key

# 允许的主机（逗号分隔）
ALLOWED_HOSTS=*

# CORS 允许的前端域名（逗号分隔，留空则不限制）
CORS_ALLOWED_ORIGINS=

# CSRF 信任来源（逗号分隔，如 https://your-domain.com）
CSRF_TRUSTED_ORIGINS=

# PostgreSQL 数据库配置
DB_NAME=rdbase
DB_USER=rdbase
DB_PASSWORD=rdbase_secret
# 数据库连接最大存活时间（秒）
DB_CONN_MAX_AGE=60

# Gunicorn 配置
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
